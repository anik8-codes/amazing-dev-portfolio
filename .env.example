# Copy to .env (git-ignored) and fill in. Real values live in GitHub / Cloudflare secrets.
# Nothing is read yet; each entry is added by the task that needs it.

# --- infra (T04): GitHub Actions secrets, not used by the site build ---
# CLOUDFLARE_API_TOKEN=        # scopes: Pages edit, R2 edit, D1 edit, Workers KV edit, DNS edit
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_ZONE_ID=
# R2_STATE_ACCESS_KEY_ID=      # R2 API token for the tofu-state bucket
# R2_STATE_SECRET_ACCESS_KEY=
